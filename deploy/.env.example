# Adresse publique de l'app.
# Sans nom de domaine : l'IP du VPS, avec CADDY_TLS="tls internal" (HTTPS auto-signé :
# le navigateur affiche un avertissement à accepter une fois, mais caméra et micro fonctionnent).
# Avec un nom de domaine : le domaine, et CADDY_TLS vide (certificat Let's Encrypt automatique).
DOMAIN=203.0.113.10
CADDY_TLS="tls internal"

# Générer avec : openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# true = comptes fictifs animés + bouton « Réinitialiser la démo » (efface toute la base !).
# À laisser sur false dès que de vrais utilisateurs s'inscrivent.
DEMO_MODE=false
# true = documentation interactive de l'API publiée sur /docs
SWAGGER=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Relais TURN facultatif pour la visio (réseaux 4G / entreprise)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
