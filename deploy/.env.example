# Domaine pointant vers l'IP du VPS (enregistrement DNS A).
# Sans nom de domaine : utilisez <IP-du-VPS>.sslip.io (ex. 203.0.113.10.sslip.io)
DOMAIN=lirel.example.com

# Générer avec : openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

DEMO_MODE=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Relais TURN facultatif pour la visio (réseaux 4G / entreprise)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
