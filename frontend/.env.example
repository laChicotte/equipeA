# URL de l'API NestJS (dossier backend/)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Visio : relais TURN facultatif (ex. coturn, Metered, Twilio), utile quand les deux participants
# sont derrière des réseaux restrictifs (4G, entreprise). Sans lui, seuls les serveurs STUN publics sont utilisés.
# NEXT_PUBLIC_TURN_URL=turn:turn.exemple.org:3478,turns:turn.exemple.org:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
