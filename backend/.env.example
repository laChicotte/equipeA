# Connexion PostgreSQL (cf. docker-compose.yml à la racine du projet)
DATABASE_URL="postgresql://lirel:lirel@localhost:5442/lirel?schema=public"

# Port de l'API et origine autorisée du front (CORS)
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Secret de signature des jetons JWT : à remplacer par une longue chaîne aléatoire en production
JWT_SECRET="change-moi"
JWT_EXPIRES_IN="7d"

# Mode démonstration : réponses automatiques des comptes de démo et réinitialisation des données
DEMO_MODE=true

# Assistant conversationnel (modèle de langage via Groq) : clé gratuite à créer sur https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
